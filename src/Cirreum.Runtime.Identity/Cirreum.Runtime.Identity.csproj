<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Cirreum.Runtime</RootNamespace>
		<Description>Runtime Extensions umbrella package for the Cirreum Identity provider family. Exposes app-facing AddIdentity() / MapIdentity() extensions that register every shipped provider protocol (Oidc and EntraExternalId) and map all provisioning routes. Self-contained: composes the protocol packages and the identity runtime directly. Apps needing a single protocol install Cirreum.Runtime.Identity.Oidc or Cirreum.Runtime.Identity.EntraExternalId instead.</Description>
		<PackageTags>cirreum;runtime;identity;oidc;entraexternalid;providers;umbrella</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Composed directly from the layers below (identity runtime + the two protocol
			packages) — never from same-layer siblings. An intra-layer dependency ships one
			release behind under batch release + lowest-wins resolution, handing
			umbrella-only consumers a stale transitive graph.
		-->
		<PackageReference Include="Cirreum.Runtime.IdentityProvider" Version="1.1.4" />
		<PackageReference Include="Cirreum.Identity.Oidc" Version="1.1.2" />
		<PackageReference Include="Cirreum.Identity.EntraExternalId" Version="2.1.3" />
	</ItemGroup>

</Project>
